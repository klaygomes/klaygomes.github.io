---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
<title type="text">{{ site.title | xml_escape }}</title>
<subtitle type="text">{{ site.description | strip_newlines | strip | xml_escape }}</subtitle>
<generator uri="https://jekyllrb.com/">Jekyll</generator>
<link rel="self" type="application/atom+xml" href="{{ site.url }}/feed.xml" />
<link rel="alternate" type="text/html" href="{{ site.url }}/" />
<updated>{{ site.time | date_to_xmlschema }}</updated>
<id>{{ site.url }}/</id>
<author>
  <name>{{ site.author.name | xml_escape }}</name>
  <uri>{{ site.url }}/</uri>
  {% if site.author.email %}<email>{{ site.author.email }}</email>{% endif %}
</author>
{% for post in site.posts limit:20 %}
{% if post.author and site.data.authors[post.author] %}
  {% assign author = site.data.authors[post.author] %}
{% else %}
  {% assign author = site.author %}
{% endif %}
<entry>
  <title type="html"><![CDATA[{{ post.title | cdata_escape }}]]></title>
  <link rel="alternate" type="text/html" href="{{ site.url }}{{ post.url }}" />
  <id>{{ site.url }}{{ post.id }}</id>
  <published>{{ post.date | date_to_xmlschema }}</published>
  <updated>{{ post.modified | default: post.date | date_to_xmlschema }}</updated>
  <author>
    <name>{{ author.name | xml_escape }}</name>
    <uri>{{ site.url }}/</uri>
    {% if author.email %}<email>{{ author.email }}</email>{% endif %}
  </author>
  {% if post.excerpt %}<summary type="text">{{ post.excerpt | strip_html | strip_newlines | strip | xml_escape }}</summary>{% endif %}
  <content type="html">
    {{ post.content | xml_escape }}
&lt;p&gt;&lt;a href=&quot;{{ site.url }}{{ post.url }}&quot;&gt;{{ post.title | xml_escape | xml_escape }}&lt;/a&gt; was originally
published by {{ site.author.name | xml_escape }} at &lt;a href=&quot;{{ site.url }}/&quot;&gt;{{ site.title | xml_escape }}&lt;/a&gt; on {{
post.date | date: "%B %d, %Y" }}.&lt;/p&gt;
  </content>
</entry>
{% endfor %}
</feed>
