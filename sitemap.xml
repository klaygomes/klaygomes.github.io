---
layout: null
sitemap: false
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for post in site.posts %}
{%- unless post.sitemap == false %}
  <url>
    <loc>{{ site.url }}{{ post.url | xml_escape }}</loc>
    <lastmod>{{ post.modified | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endunless %}
{%- endfor %}
{%- for page in site.html_pages %}
{%- unless page.sitemap == false %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: "/index.html", "/" | xml_escape }}</loc>
    {%- assign lastmod = page.modified | default: page.date %}
    {%- if lastmod %}
    <lastmod>{{ lastmod | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
